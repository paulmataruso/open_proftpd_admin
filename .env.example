# ── Main user-management database ─────────────────────────────────────────────
POSTGRES_DB=ciosuseradd
POSTGRES_USER=ftpadmin
POSTGRES_PASSWORD=CHANGEME_strong_password_here

# ── FTP activity log database (separate container) ─────────────────────────────
LOGS_POSTGRES_DB=ftplogs
LOGS_POSTGRES_USER=logsadmin
LOGS_POSTGRES_PASSWORD=CHANGEME_separate_strong_password
# Optional memory tuning for the logs DB (defaults shown). The stats queries
# scan the whole download history; on a host with RAM to spare, raising
# shared_buffers/effective_cache_size toward ~1/4 and ~1/2 of RAM helps.
# LOGS_PG_SHARED_BUFFERS=1GB
# LOGS_PG_EFFECTIVE_CACHE_SIZE=4GB
# LOGS_PG_WORK_MEM=64MB
# LOGS_PG_MAINTENANCE_WORK_MEM=256MB
# LOGS_PG_SHM_SIZE=1g

# ── JWT & admin credentials ────────────────────────────────────────────────────
# Generate SECRET_KEY with: openssl rand -hex 32
# ADMIN_USERNAME and ADMIN_PASSWORD seed the DB on first start only.
# After first start, use the Settings panel in the admin UI to change them.
SECRET_KEY=CHANGEME_run_openssl_rand_hex_32_and_paste_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEME_strong_admin_password

# ── ProFTPd virtual user config ────────────────────────────────────────────────
# Run: id <your_ftp_system_user>  on the FTP server to get UID/GID.
# These apply to regular (read-only) and anonymous FTP users.
FTP_UID=1001
FTP_GID=1001
# GID that Trusted (R/W) FTP users' uploaded files/folders are owned by —
# should be www-data's GID (run: getent group www-data) so the web server can
# read what they upload. Only affects Trusted users; regular/anon use FTP_GID above.
TRUSTED_FTP_GID=33
# Directory on the host containing ftpd.passwd and ftpd_trusted.conf (must exist before first run)
FTPD_PASSWD_DIR=/etc/proftpd

# ── Trusted FTP users ──────────────────────────────────────────────────────────
# Base directory under which trusted user home folders live on the FTP server.
# Each trusted user gets their own chroot at FTP_BASE_PATH/<ftp_home_dir>.
# Create the folder manually on the FTP server before the user first connects.
FTP_BASE_PATH=/srv/ftp

# ── Branding & public login ────────────────────────────────────────────────────
# SITE_NAME is shown in page titles/headers; FTP_PUBLIC_HOST (optional) is shown
# as the connection host on the registration page.
SITE_NAME=FTP User Manager
FTP_PUBLIC_HOST=ftp.example.com
# Shared public HTTP basic-auth login kept on the first line of .htpasswd.
# Its downloads are counted as anonymous in stats, and it can't be registered.
PUBLIC_HTTP_USERNAME=public
# Optional "wrong login page?" pointer, shown in large type on the admin login
# page's intrusion warning / ban messages: "Trying to get to <NAME>? Please go
# to <URL>". For visitors who land here looking for another site. Leave the URL
# empty to hide it.
WRONG_PORTAL_NAME=
WRONG_PORTAL_URL=

# ── Private FTP users ──────────────────────────────────────────────────────────
# Separate base directory for Private (R/W) FTP users — NOT under FTP_BASE_PATH.
# Each private user is chrooted to PRIVATE_FTP_BASE_PATH/<home_folder>; the
# backend creates that folder (mode 750). Must be a host path.
PRIVATE_FTP_BASE_PATH=/srv/private_ftp

# Dedicated host group for private users — ProFTPd chroots members of this
# group to their home via `DefaultRoot ~ <group>`, so it must not be shared with
# any other FTP user class. Create it on the FTP host:
#   groupadd --system privateftp && getent group privateftp
# Home folders and uploads are owned FTP_UID:PRIVATE_FTP_GID.
PRIVATE_FTP_GROUP=privateftp
PRIVATE_FTP_GID=

# ── CORS & network binding ─────────────────────────────────────────────────────
# Use * for testing. Set your actual HTTPS domain in production:
#   ALLOWED_ORIGINS=https://ftp.yourdomain.com
ALLOWED_ORIGINS=*
# BIND_IP: 0.0.0.0 = all interfaces (testing), 127.0.0.1 = localhost only,
#          or a specific LAN IP when NPM is on a different host
BIND_IP=127.0.0.1
LISTEN_PORT=8080

# ── FTP log directory ──────────────────────────────────────────────────────────
# The entire ProFTPd log directory is bind-mounted read-only into the logtailer.
# The specific log filename (default: full_user.log) is set in the Settings panel.
# Must match the directory containing your ExtendedLog files.
FTP_LOG_DIR=/var/log/proftpd

# ── HTTP log directory ─────────────────────────────────────────────────────────
# The nginx log directory containing http_downloads.log (or your configured filename).
# The specific filename is set in the Settings panel (default: http_downloads.log).
HTTP_LOG_DIR=/var/log/nginx

# ── nginx .htpasswd directory ──────────────────────────────────────────────────
# Directory on the host that contains .htpasswd.
# The backend writes this file whenever users are created/modified/deleted.
# The first line of the existing file (the shared public login) is always preserved verbatim.
HTPASSWD_DIR=/etc/nginx

# ── FTP ban system (ftpban) ────────────────────────────────────────────────────
# Directory where the host-side ban daemon (ftpban/ciosuseradd-ftpban.service)
# keeps ftpban.db. Bind-mounted read-write into backend (manual bans, unbans and
# settings are written there). Must match FTPBAN_DIR in the systemd unit.
FTPBAN_DIR=/var/lib/ciosuseradd/ftpban

# ── Live FTP sessions (ftpwho) ─────────────────────────────────────────────────
# Directory the host-side ftpwho exporter (ftpwho/ciosuseradd-ftpwho.service)
# writes ftpwho.json into. Bind-mounted read-only into backend. Must match the
# FTPWHO_DIR in the systemd unit.
FTPWHO_DIR=/var/lib/ciosuseradd/ftpwho
